# Copiar a .env y completar fuera de Git. No se admiten comentarios al final de valores.
APP_ENV=local
TRUST_PROXY=false
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=colegio_db
DB_USER=liceomap_reader
DB_PASSWORD=
# false solo para loopback o db/test-db en Docker local/test.
DB_TLS_REQUIRED=false
DB_TLS_CA=
PORT=8080
# Solo para Compose local: completar valores diferentes y mantenerlos fuera de Git.
LOCAL_DB_ROOT_PASSWORD=
LOCAL_DB_PASSWORD=
# Solo para Compose de integración, base dedicada; no usar credenciales de producción.
TEST_DB_ROOT_PASSWORD=
TEST_DB_PASSWORD=
